# ── Required ──────────────────────────────────────────────────────────────────

# Admin account created automatically on first start
ADMIN_USERNAME=admin
ADMIN_PASSWORD=changeme

# Must be a long random string — used to sign session cookies
# Generate one with: openssl rand -hex 32
SESSION_SECRET=change-this-to-a-random-string

# ── Optional ──────────────────────────────────────────────────────────────────

# Port the server listens on (default: 3001)
# PORT=3001

# Google Books API key — used for book metadata and cover lookup
# Get one at https://console.developers.google.com
# GOOGLE_BOOKS_API_KEY=

# Gemini API key — used by the AI integration plugin
# Get one at https://aistudio.google.com
# GEMINI_API_KEY=
