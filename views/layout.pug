doctype html
html
    head
        block title
            title BookNook
        meta(name="viewport" content="width=device-width, initial-scale=1")
        link(rel="icon" href="/assets/favicon.svg")
        link(rel="stylesheet" href="/styles.css")
        each href in (pluginStylesheets || [])
            link(rel="stylesheet" href=href)
        script.
            const _t = localStorage.getItem('theme');
            if (_t) document.documentElement.setAttribute('data-theme', _t);
        block head
    body
        .app-layout
            aside.sidebar
                .sidebar__top
                    a.sidebar__logo(href='/')
                        img(src="/assets/logo-dark.svg" alt="BookNook" height="28")
                - const _excl = (user && !user.isAdmin) ? (user.permissions || []) : []
                nav.sidebar__nav
                    if !_excl.includes('books')
                        a.sidebar__link(href='/' class=currentPath === '/' ? 'sidebar__link--active' : '')
                            svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                path(d="M4 19.5A2.5 2.5 0 0 1 6.5 17H20")
                                path(d="M6.5 2H20v20H6.5A2.5 2.5 0 0 1 4 19.5v-15A2.5 2.5 0 0 1 6.5 2z")
                            span Library
                    if !_excl.includes('comics')
                        a.sidebar__link(href='/comics' class=currentPath === '/comics' ? 'sidebar__link--active' : '')
                            svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                rect(x="2" y="3" width="20" height="14" rx="2" ry="2")
                                line(x1="8" y1="21" x2="16" y2="21")
                                line(x1="12" y1="17" x2="12" y2="21")
                            span Comics
                    if user && user.isAdmin
                        a.sidebar__link(href='/library' class=currentPath === '/library' ? 'sidebar__link--active' : '')
                            svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                path(d="M3 3h18v18H3z")
                                path(d="M3 9h18")
                                path(d="M3 15h18")
                                path(d="M9 3v18")
                            span Manage
                    a.sidebar__link(href='/settings' class=currentPath === '/settings' ? 'sidebar__link--active' : '')
                        svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                            circle(cx="12" cy="12" r="3")
                            path(d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1-2.83 2.83l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-4 0v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83-2.83l.06-.06A1.65 1.65 0 0 0 4.68 15a1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1 0-4h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 2.83-2.83l.06.06A1.65 1.65 0 0 0 9 4.68a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 4 0v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 2.83l-.06.06A1.65 1.65 0 0 0 19.4 9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 0 4h-.09a1.65 1.65 0 0 0-1.51 1z")
                        span Settings
                    if !_excl.includes('plugins') && (pluginNavItems || []).length
                        span.sidebar__section Plugins
                        each item in (pluginNavItems || [])
                            a.sidebar__link(href=item.href class=currentPath.startsWith(item.href) ? 'sidebar__link--active' : '')
                                if item.icon
                                    != item.icon
                                else
                                    svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                                        circle(cx="12" cy="12" r="6")
                                span= item.label
                .sidebar__bottom
                    button.sidebar__theme#theme-toggle(aria-label="Toggle theme") ◐
                    if user
                        .sidebar__user
                            span.sidebar__username= user.username
                            form(action='/logout' method='POST')
                                button.sidebar__signout(type='submit') Sign out
            #sidebar-backdrop.sidebar-backdrop
            .page-content
                .topbar
                    button.topbar__toggle#sidebar-toggle(aria-label="Toggle sidebar")
                        span
                        span
                        span
                    a.topbar__logo(href='/')
                        img(src="/assets/logo-dark.svg" alt="BookNook" height="24")
                block content
                footer.footer
                    .row
                        p.footer__copyright © BookNook
        each src in (pluginScripts || [])
            script(src=src)
        block scripts
        script.
            const html = document.documentElement;
            const sidebar = document.querySelector('.sidebar');
            const backdrop = document.getElementById('sidebar-backdrop');
            const sidebarToggle = document.getElementById('sidebar-toggle');
            const _saved = localStorage.getItem('sidebarCollapsed');
            const sidebarCollapsed = _saved === '1' || (window.innerWidth <= 480 && _saved !== '0');
            if (sidebarCollapsed) sidebar.classList.add('sidebar--collapsed');
            const closeSidebar = () => {
                sidebar.classList.add('sidebar--collapsed');
                backdrop.classList.remove('sidebar-backdrop--visible');
                localStorage.setItem('sidebarCollapsed', '1');
                setTimeout(() => document.dispatchEvent(new CustomEvent('layout-changed')), 260);
            };
            sidebarToggle.addEventListener('click', () => {
                const collapsed = sidebar.classList.toggle('sidebar--collapsed');
                backdrop.classList.toggle('sidebar-backdrop--visible', !collapsed);
                localStorage.setItem('sidebarCollapsed', collapsed ? '1' : '0');
                setTimeout(() => document.dispatchEvent(new CustomEvent('layout-changed')), 260);
            });
            backdrop.addEventListener('click', closeSidebar);
            document.querySelectorAll('.sidebar__link').forEach(link => {
                link.addEventListener('click', () => {
                    if (backdrop.classList.contains('sidebar-backdrop--visible')) closeSidebar();
                });
            });
            const toggle = document.getElementById('theme-toggle');
            const updateToggle = () => {
                toggle.textContent = html.getAttribute('data-theme') === 'dark' ? '◑' : '◐';
            };
            updateToggle();
            toggle.addEventListener('click', () => {
                const next = html.getAttribute('data-theme') === 'dark' ? 'light' : 'dark';
                html.setAttribute('data-theme', next);
                localStorage.setItem('theme', next);
                updateToggle();
            });
