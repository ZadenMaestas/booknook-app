extends layout

block title
    title= book.title + ' — BookNook'

block head
    style.
        html, body { overflow: hidden; height: 100%; }

block content
    main.reader
        .reader__topbar
            a.reader__back(href='/' title='Back to library')
                svg(xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                    polyline(points="15 18 9 12 15 6")
            .reader__title-wrap
                p.reader__title= book.title
                p.reader__author= book.author || 'Unknown'
            .reader__topbar-end
                button#dual-btn.reader__icon-btn(title="Switch to dual page")
                    svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                        rect(x="2" y="3" width="8" height="18" rx="1.5")
                        rect(x="14" y="3" width="8" height="18" rx="1.5")
                button#fs-toggle.reader__icon-btn(title="Fullscreen")
                    svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                        polyline#fs-icon-open(points="15 3 21 3 21 9")
                        polyline(points="9 21 3 21 3 15")
                        line(x1="21" y1="3" x2="14" y2="10")
                        line(x1="3" y1="21" x2="10" y2="14")
        .reader__progress
            #progress-fill.reader__progress-fill
        foliate-view#viewer.reader__viewer
        .reader__controls
            button#prev.reader__nav-btn
                svg(xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                    polyline(points="15 18 9 12 15 6")
                | Prev
            .reader__page-wrap
                input#page-input.reader__page-input(type="number" min="0" aria-label="Go to page")
            button#next.reader__nav-btn
                | Next
                svg(xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                    polyline(points="9 18 15 12 9 6")

block scripts
    script(type="module").
        import '/foliate-js/view.js'

        const BOOK_ID   = !{JSON.stringify(book.id)};
        const SAVED_CFI = !{JSON.stringify(progress && progress.cfi || null)};
        const SAVED_PAGE = !{JSON.stringify(progress && progress.page != null ? progress.page : 0)};
        const IS_PDF    = !{JSON.stringify(book.filePath.endsWith('.pdf'))};

        const viewer       = document.getElementById('viewer');
        const pageInput    = document.getElementById('page-input');
        const progressFill = document.getElementById('progress-fill');
        const fsBtn        = document.getElementById('fs-toggle');
        const dualBtn      = document.getElementById('dual-btn');
        const btnPrev      = document.getElementById('prev');
        const btnNext      = document.getElementById('next');

        const isDark = () => document.documentElement.getAttribute('data-theme') === 'dark';

        const baseCSS = `
            @namespace epub "http://www.idpf.org/2007/ops";
            p, li, blockquote, dd {
                line-height: 1.6;
                text-align: justify;
                -webkit-hyphens: auto;
                hyphens: auto;
                -webkit-hyphenate-limit-before: 3;
                -webkit-hyphenate-limit-after: 2;
                -webkit-hyphenate-limit-lines: 2;
                hanging-punctuation: allow-end last;
                widows: 2;
            }
            [align="left"] { text-align: left; }
            [align="right"] { text-align: right; }
            [align="center"] { text-align: center; }
            [align="justify"] { text-align: justify; }
            pre { white-space: pre-wrap !important; }
            aside[epub|type~="endnote"], aside[epub|type~="footnote"],
            aside[epub|type~="note"], aside[epub|type~="rearnote"] {
                display: none;
            }
        `;

        // Explicit colour-scheme on each branch so the iframe never inherits the OS
        // setting independently of the app's own theme toggle.
        const lightCSS = `
            html, body {
                color-scheme: light !important;
                background: #fff !important;
                color: #1a1a1a !important;
            }
        `;

        const darkCSS = `
            html, body {
                color-scheme: dark !important;
                background: #1a1d29 !important;
                color: #d4cfc8 !important;
            }
            p, h1, h2, h3, h4, h5, h6, li, span, div,
            td, th, dt, dd, caption, figcaption,
            b, i, em, strong, cite, q, blockquote,
            section, article, header, footer, main, nav, aside {
                color: #d4cfc8 !important;
                background-color: transparent !important;
            }
            a, a * { color: #c47a3b !important; }
            pre, code, tt, kbd, samp {
                background: #252837 !important;
                color: #b8d0eb !important;
            }
            img { filter: brightness(0.85); }
        `;

        const getCSS = () => isDark() ? [baseCSS, darkCSS] : [baseCSS, lightCSS];

        btnPrev.disabled = true;
        btnNext.disabled = true;

        // Own page counter: 0 = cover/first screen, increments/decrements with nav.
        // Stored per user in DB alongside the CFI (which handles actual position restore).
        let page = SAVED_PAGE;
        pageInput.value = page;

        // Dual-page mode — auto-enabled when viewer is wide enough
        let isDualPage = false;

        function applyDualPage(dual) {
            if (dual === isDualPage) return;
            isDualPage = dual;
            viewer.renderer?.setAttribute('max-column-count', dual ? '2' : '1');
            dualBtn.classList.toggle('is-active', dual);
            dualBtn.title = dual ? 'Switch to single page' : 'Switch to dual page';
        }
        dualBtn.addEventListener('click', () => applyDualPage(!isDualPage));
        const syncDualPage = () => applyDualPage(viewer.offsetWidth >= 900);

        const saveProgress = (cfi, fraction) => {
            fetch('/books/' + BOOK_ID + '/progress', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ cfi: cfi ?? String(fraction), percentage: fraction, page }),
            });
        };

        // navDirection: set on button/key press, consumed by next relocate.
        // suppressCount: skips intermediate relocate in dual mode (first of two goRight calls).
        // isJumping: goToPage owns relocate events while active.
        let navDirection = 0;
        let navTimeout   = null;
        let suppressCount = 0;
        let isJumping    = false;
        let lastCfi      = null;

        const goNavStep = (forward) => {
            clearTimeout(navTimeout);
            navDirection = forward ? 1 : -1;
            if (isDualPage) {
                suppressCount++;
                forward ? viewer.goRight() : viewer.goLeft();
                setTimeout(() => { forward ? viewer.goRight() : viewer.goLeft(); }, 160);
                navTimeout = setTimeout(() => { navDirection = 0; suppressCount = Math.max(0, suppressCount - 1); }, 700);
            } else {
                forward ? viewer.goRight() : viewer.goLeft();
                navTimeout = setTimeout(() => { navDirection = 0; }, 400);
            }
        };

        // Jump to a target page by simulating next/prev one step at a time.
        // Temporarily switches to single column so each step is always one column,
        // then restores the original mode at the end.
        const goToPage = async (target) => {
            const delta = target - page;
            if (delta === 0 || isJumping) return;
            const forward = delta > 0;
            const steps   = Math.abs(delta);

            isJumping = true;
            btnPrev.disabled = true;
            btnNext.disabled = true;

            const wasDual = isDualPage;
            if (wasDual) viewer.renderer?.setAttribute('max-column-count', '1');

            for (let i = 0; i < steps; i++) {
                const prevCfi = lastCfi;
                forward ? viewer.goRight() : viewer.goLeft();

                const result = await new Promise(resolve => {
                    const t = setTimeout(() => resolve(null), 400);
                    const h = ({ detail }) => {
                        clearTimeout(t);
                        viewer.removeEventListener('relocate', h);
                        resolve(detail);
                    };
                    viewer.addEventListener('relocate', h);
                });

                if (!result || result.cfi === prevCfi) break; // hit boundary
                lastCfi = result.cfi;
                page = forward ? page + 1 : Math.max(0, page - 1);
                pageInput.value = page;
                progressFill.style.width = (result.fraction * 100) + '%';
            }

            if (wasDual) viewer.renderer?.setAttribute('max-column-count', '2');
            isJumping = false;
            btnPrev.disabled = false;
            btnNext.disabled = false;
            if (viewer.lastLocation) saveProgress(viewer.lastLocation.cfi, viewer.lastLocation.fraction ?? 0);
        };

        pageInput.addEventListener('keydown', e => {
            if (e.key !== 'Enter') return;
            const n = parseInt(pageInput.value, 10);
            if (!isNaN(n) && n >= 0) goToPage(n);
        });
        pageInput.addEventListener('blur', () => { pageInput.value = page; });

        viewer.addEventListener('relocate', ({ detail }) => {
            if (isJumping) return;
            const { fraction, cfi } = detail;
            if (suppressCount > 0) { suppressCount--; return; }
            if (navDirection !== 0) {
                if (cfi !== lastCfi) page = Math.max(0, page + navDirection);
                navDirection = 0;
            }
            lastCfi = cfi;
            pageInput.value = page;
            progressFill.style.width = (fraction * 100) + '%';
            saveProgress(cfi, fraction);
        });

        const handleKeydown = e => {
            if (e.key === 'ArrowLeft') goNavStep(false);
            else if (e.key === 'ArrowRight') goNavStep(true);
            else if (e.key === 'Escape' && document.fullscreenElement) document.exitFullscreen();
        };

        viewer.addEventListener('load', ({ detail: { doc } }) => {
            viewer.renderer?.setAttribute('max-column-count', isDualPage ? '2' : '1');
            viewer.renderer.setStyles?.(getCSS());
            doc.addEventListener('keydown', handleKeydown);
        });

        document.getElementById('theme-toggle')?.addEventListener('click', () => {
            viewer.renderer.setStyles?.(getCSS());
        });

        btnPrev.addEventListener('click', () => goNavStep(false));
        btnNext.addEventListener('click', () => goNavStep(true));
        document.addEventListener('keydown', handleKeydown);

        fsBtn.addEventListener('click', () => {
            if (!document.fullscreenElement) viewer.requestFullscreen();
            else document.exitFullscreen();
        });
        document.addEventListener('fullscreenchange', () => {
            fsBtn.title = document.fullscreenElement ? 'Exit fullscreen' : 'Fullscreen';
            const icon = document.getElementById('fs-icon-open');
            if (document.fullscreenElement) {
                icon.setAttribute('points', '20 14 14 20 20 20');
                document.querySelector('#fs-toggle polyline:last-of-type')?.setAttribute('points', '4 10 10 4 4 4');
            } else {
                icon.setAttribute('points', '15 3 21 3 21 9');
                document.querySelector('#fs-toggle polyline:last-of-type')?.setAttribute('points', '9 21 3 21 3 15');
            }
        });

        viewer.open('/books/file/' + BOOK_ID)
            .then(() => {
                viewer.renderer.setStyles?.(getCSS());
                syncDualPage();
                new ResizeObserver(syncDualPage).observe(viewer);
                btnPrev.disabled = false;
                btnNext.disabled = false;
                if (SAVED_CFI && SAVED_CFI.startsWith('epubcfi(')) {
                    viewer.goTo(SAVED_CFI);
                } else if (SAVED_CFI && IS_PDF) {
                    const fraction = parseFloat(SAVED_CFI);
                    if (!isNaN(fraction) && fraction > 0) viewer.goToFraction(fraction);
                } else {
                    viewer.renderer.next();
                }
            })
            .catch(err => console.error('Failed to open book:', err));
