extends layout

block title
    title= book.title + ' — BookNook'

block head
    style.
        html, body { overflow: hidden; height: 100%; }

block content
    main.reader
        .reader__topbar
            a.reader__back(href='/' title='Back to library')
                svg(xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                    polyline(points="15 18 9 12 15 6")
            .reader__title-wrap
                p.reader__title= book.title
                p.reader__author= book.author || 'Unknown'
            .reader__topbar-end
                button#dual-btn.reader__icon-btn.is-active(title="Switch to single page")
                    svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                        rect(x="2" y="3" width="8" height="18" rx="1.5")
                        rect(x="14" y="3" width="8" height="18" rx="1.5")
                button#fs-toggle.reader__icon-btn(title="Fullscreen")
                    svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                        polyline#fs-icon-open(points="15 3 21 3 21 9")
                        polyline(points="9 21 3 21 3 15")
                        line(x1="21" y1="3" x2="14" y2="10")
                        line(x1="3" y1="21" x2="10" y2="14")
        .reader__progress
            #progress-fill.reader__progress-fill
        foliate-view#viewer.reader__viewer
        .reader__controls
            button#prev.reader__nav-btn
                svg(xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                    polyline(points="15 18 9 12 15 6")
                | Prev
            .reader__page-wrap
                input#page-input.reader__page-input(type="number" min="1" aria-label="Go to location" disabled)
                span#page-right.reader__page-right
                span.reader__page-sep /
                span#page-total.reader__page-total
            button#next.reader__nav-btn
                | Next
                svg(xmlns="http://www.w3.org/2000/svg" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                    polyline(points="9 18 15 12 9 6")

block scripts
    script(type="module").
        import '/foliate-js/view.js'

        const BOOK_ID   = !{JSON.stringify(book.id)};
        const SAVED_CFI = !{JSON.stringify(progress && progress.cfi || null)};
        const IS_PDF    = !{JSON.stringify(book.filePath.endsWith('.pdf'))};

        const viewer       = document.getElementById('viewer');
        const pageInput    = document.getElementById('page-input');
        const pageTotal    = document.getElementById('page-total');
        const pageRight    = document.getElementById('page-right');
        const progressFill = document.getElementById('progress-fill');
        const fsBtn        = document.getElementById('fs-toggle');
        const dualBtn      = document.getElementById('dual-btn');
        const btnPrev      = document.getElementById('prev');
        const btnNext      = document.getElementById('next');

        const isDark = () => document.documentElement.getAttribute('data-theme') === 'dark';

        const baseCSS = `
            @namespace epub "http://www.idpf.org/2007/ops";
            p, li, blockquote, dd {
                line-height: 1.6;
                text-align: justify;
                -webkit-hyphens: auto;
                hyphens: auto;
                widows: 2;
            }
            pre { white-space: pre-wrap !important; }
            aside[epub|type~="endnote"], aside[epub|type~="footnote"],
            aside[epub|type~="note"], aside[epub|type~="rearnote"] {
                display: none;
            }
        `;

        const darkOverrideCSS = `
            html, body {
                background: #1a1d29 !important;
                color: #d4cfc8 !important;
            }
            p, h1, h2, h3, h4, h5, h6, li, span, div,
            td, th, dt, dd, caption, figcaption,
            b, i, em, strong, cite, q, blockquote,
            section, article, header, footer, main, nav, aside {
                color: #d4cfc8 !important;
                background-color: transparent !important;
            }
            a, a * { color: #c47a3b !important; }
            pre, code, tt, kbd, samp {
                background: #252837 !important;
                color: #b8d0eb !important;
            }
            img { filter: brightness(0.85); }
        `;

        const getCSS = () => isDark()
            ? [baseCSS, darkOverrideCSS]
            : [baseCSS, ''];

        btnPrev.disabled = true;
        btnNext.disabled = true;
        pageInput.disabled = true;

        let totalLoc = 0;
        let isDualPage = true;

        dualBtn.addEventListener('click', () => {
            isDualPage = !isDualPage;
            viewer.renderer?.setAttribute('max-column-count', isDualPage ? '2' : '1');
            dualBtn.classList.toggle('is-active', isDualPage);
            dualBtn.title = isDualPage ? 'Switch to single page' : 'Switch to dual page';
            updatePageCounter();
        });

        pageInput.addEventListener('keydown', e => {
            if (e.key !== 'Enter') return;
            const n = parseInt(pageInput.value, 10);
            if (!isNaN(n) && totalLoc > 0) viewer.goToFraction((n - 1) / totalLoc);
        });
        pageInput.addEventListener('blur', () => {
            if (totalLoc > 0) pageInput.value = parseInt(pageInput.value, 10) || 1;
        });

        const saveProgress = (cfi, fraction) => {
            fetch('/books/' + BOOK_ID + '/progress', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ cfi: cfi ?? String(fraction), percentage: fraction }),
            });
        };

        const updatePageCounter = () => {
            const loc = viewer.lastLocation?.location;
            if (!loc) return;
            totalLoc = loc.total;
            pageInput.value = loc.current + 1;
            pageInput.max = totalLoc;
            pageTotal.textContent = totalLoc;
            if (isDualPage && loc.next > loc.current) {
                pageRight.textContent = '–' + (loc.next + 1);
                pageRight.style.display = 'inline';
            } else {
                pageRight.style.display = 'none';
            }
        };

        viewer.addEventListener('relocate', ({ detail }) => {
            const { fraction, cfi } = detail;
            progressFill.style.width = (fraction * 100) + '%';
            saveProgress(cfi, fraction);
        });

        viewer.addEventListener('load', () => {
            viewer.renderer.setStyles?.(getCSS());
        });

        document.getElementById('theme-toggle')?.addEventListener('click', () => {
            viewer.renderer.setStyles?.(getCSS());
        });

        btnPrev.addEventListener('click', () => viewer.goLeft());
        btnNext.addEventListener('click', () => viewer.goRight());

        document.addEventListener('keydown', e => {
            if (e.key === 'ArrowLeft') viewer.goLeft();
            if (e.key === 'ArrowRight') viewer.goRight();
            if (e.key === 'Escape' && document.fullscreenElement) document.exitFullscreen();
        });

        fsBtn.addEventListener('click', () => {
            if (!document.fullscreenElement) viewer.requestFullscreen();
            else document.exitFullscreen();
        });
        document.addEventListener('fullscreenchange', () => {
            fsBtn.title = document.fullscreenElement ? 'Exit fullscreen' : 'Fullscreen';
            const icon = document.getElementById('fs-icon-open');
            if (document.fullscreenElement) {
                icon.setAttribute('points', '20 14 14 20 20 20');
                document.querySelector('#fs-toggle polyline:last-of-type')?.setAttribute('points', '4 10 10 4 4 4');
            } else {
                icon.setAttribute('points', '15 3 21 3 21 9');
                document.querySelector('#fs-toggle polyline:last-of-type')?.setAttribute('points', '9 21 3 21 3 15');
            }
        });

        viewer.open('/books/file/' + BOOK_ID)
            .then(() => {
                viewer.renderer.setStyles?.(getCSS());
                btnPrev.disabled = false;
                btnNext.disabled = false;
                pageInput.disabled = false;
                // Listen on the renderer (not foliate-view) to get `reason`.
                // Skip 'anchor' (font-load / resize re-anchors) — those auto-relocates
                // shift position by ~1 page and corrupt the counter.
                // foliate-view's own listener runs first and updates lastLocation before ours.
                viewer.renderer.addEventListener('relocate', ({ detail: { reason } }) => {
                    if (reason === 'anchor' || reason === 'selection') return;
                    updatePageCounter();
                });
                if (SAVED_CFI && SAVED_CFI.startsWith('epubcfi(')) {
                    viewer.goTo(SAVED_CFI);
                } else if (SAVED_CFI && IS_PDF) {
                    const fraction = parseFloat(SAVED_CFI);
                    if (!isNaN(fraction) && fraction > 0) viewer.goToFraction(fraction);
                } else {
                    viewer.renderer.next();
                }
            })
            .catch(err => console.error('Failed to open book:', err));
