extends layout

block title
    title= comic.title + ' — BookNook'

block head
    style.
        main.comic-reader {
            display: flex;
            flex-direction: column;
            height: 100%;
            background: #0d0d0d;
        }
        .comic-topbar {
            height: 48px;
            flex-shrink: 0;
            display: flex;
            align-items: center;
            gap: 12px;
            padding: 0 16px;
            background: rgba(0,0,0,.6);
            backdrop-filter: blur(8px);
            position: relative;
            z-index: 10;
        }
        .comic-back {
            color: rgba(255,255,255,.7);
            display: flex;
            align-items: center;
            text-decoration: none;
            padding: 6px;
            border-radius: 6px;
            flex-shrink: 0;
            transition: background 150ms, color 150ms;
        }
        .comic-back:hover { background: rgba(255,255,255,.08); color: #fff; }
        .comic-title-wrap { flex: 1; min-width: 0; }
        .comic-title {
            font-size: 14px;
            font-weight: 600;
            color: rgba(255,255,255,.9);
            white-space: nowrap;
            overflow: hidden;
            text-overflow: ellipsis;
            margin: 0;
        }
        .comic-subtitle { font-size: 12px; color: rgba(255,255,255,.4); margin: 0; }
        .comic-page-display {
            font-family: 'JetBrains Mono', monospace;
            font-size: 12px;
            color: rgba(255,255,255,.5);
            white-space: nowrap;
            flex-shrink: 0;
        }
        .comic-icon-btn {
            background: none;
            border: none;
            color: rgba(255,255,255,.6);
            cursor: pointer;
            padding: 6px;
            border-radius: 6px;
            display: flex;
            align-items: center;
            transition: background 150ms, color 150ms;
        }
        .comic-icon-btn:hover { background: rgba(255,255,255,.08); color: #fff; }

        .comic-stage {
            flex: 1;
            min-height: 0;
            position: relative;
            display: flex;
            align-items: center;
            justify-content: center;
            overflow: hidden;
            cursor: pointer;
            user-select: none;
        }
        .comic-page-img {
            max-width: 100%;
            max-height: 100%;
            object-fit: contain;
            display: block;
            transition: opacity 120ms;
        }
        .comic-page-img.loading { opacity: 0; }

        .comic-hit-prev, .comic-hit-next {
            position: absolute;
            top: 0;
            bottom: 0;
            width: 40%;
            z-index: 5;
        }
        .comic-hit-prev { left: 0; }
        .comic-hit-next { right: 0; }

        .comic-progress {
            height: 3px;
            background: rgba(255,255,255,.08);
            flex-shrink: 0;
        }
        .comic-progress-fill {
            height: 100%;
            background: var(--amber);
            transition: width 200ms;
        }

block content
    main.comic-reader
        .comic-topbar
            a.comic-back(href='/comics' title='Back to Comics')
                svg(xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                    polyline(points="15 18 9 12 15 6")
            .comic-title-wrap
                p.comic-title= comic.title
                if comic.series
                    p.comic-subtitle= comic.series + (comic.issue ? ' #' + comic.issue : '')
            span.comic-page-display#page-display
            button.comic-icon-btn#fs-btn(title="Fullscreen")
                svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                    polyline#fs-icon-open(points="15 3 21 3 21 9")
                    polyline(points="9 21 3 21 3 15")
                    line(x1="21" y1="3" x2="14" y2="10")
                    line(x1="3" y1="21" x2="10" y2="14")
        .comic-progress
            #progress-fill.comic-progress-fill
        .comic-stage#stage
            .comic-hit-prev#hit-prev
            .comic-hit-next#hit-next
            img.comic-page-img#page-img(alt="")

block scripts
    script.
        const COMIC_ID   = !{JSON.stringify(comic.id)};
        const SAVED_PAGE = !{JSON.stringify(savedPage)};

        const img         = document.getElementById('page-img');
        const pageDisplay = document.getElementById('page-display');
        const progressFill= document.getElementById('progress-fill');
        const fsBtn       = document.getElementById('fs-btn');

        let pages = [];
        let current = 0;

        const save = () => fetch(`/comics/${COMIC_ID}/progress`, {
            method: 'POST',
            headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ page: current }),
        });

        const show = (n) => {
            if (!pages.length) return;
            current = Math.max(0, Math.min(n, pages.length - 1));
            img.classList.add('loading');
            const src = `/comics/page/${COMIC_ID}/${encodeURIComponent(pages[current])}`;
            const tmp = new Image();
            tmp.onload = () => { img.src = src; img.classList.remove('loading'); };
            tmp.src = src;
            const pct = pages.length > 1 ? (current / (pages.length - 1)) * 100 : 100;
            progressFill.style.width = pct + '%';
            pageDisplay.textContent = `${current + 1} / ${pages.length}`;
            save();
        };

        document.getElementById('hit-prev').addEventListener('click', () => show(current - 1));
        document.getElementById('hit-next').addEventListener('click', () => show(current + 1));

        document.addEventListener('keydown', e => {
            if (e.key === 'ArrowLeft'  || e.key === 'ArrowUp')   show(current - 1);
            if (e.key === 'ArrowRight' || e.key === 'ArrowDown')  show(current + 1);
            if (e.key === 'Escape' && document.fullscreenElement) document.exitFullscreen();
        });

        fsBtn.addEventListener('click', () => {
            if (!document.fullscreenElement) document.getElementById('stage').requestFullscreen();
            else document.exitFullscreen();
        });
        document.addEventListener('fullscreenchange', () => {
            const icon = document.getElementById('fs-icon-open');
            if (document.fullscreenElement) {
                icon.setAttribute('points', '20 14 14 20 20 20');
                document.querySelector('#fs-btn polyline:last-of-type')?.setAttribute('points', '4 10 10 4 4 4');
            } else {
                icon.setAttribute('points', '15 3 21 3 21 9');
                document.querySelector('#fs-btn polyline:last-of-type')?.setAttribute('points', '9 21 3 21 3 15');
            }
        });

        fetch(`/comics/pages/${COMIC_ID}`)
            .then(r => r.json())
            .then(p => {
                pages = p;
                show(Math.min(SAVED_PAGE, pages.length - 1));
            });
