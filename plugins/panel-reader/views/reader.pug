extends /views/layout.pug

block title
    title= comic.title + ' — Panel Mode · BookNook'

block head
    style.
        main.comic-reader {
            display: flex; flex-direction: column; height: 100%; background: #0d0d0d;
        }
        .comic-topbar {
            height: 48px; flex-shrink: 0; display: flex; align-items: center; gap: 12px;
            padding: 0 16px; background: rgba(0,0,0,.6); backdrop-filter: blur(8px);
            position: relative; z-index: 10;
        }
        .comic-back {
            color: rgba(255,255,255,.7); display: flex; align-items: center;
            text-decoration: none; padding: 6px; border-radius: 6px; flex-shrink: 0;
            transition: background 150ms, color 150ms;
        }
        .comic-back:hover { background: rgba(255,255,255,.08); color: #fff; }
        .comic-title-wrap { flex: 1; min-width: 0; }
        .comic-title {
            font-size: 14px; font-weight: 600; color: rgba(255,255,255,.9);
            white-space: nowrap; overflow: hidden; text-overflow: ellipsis; margin: 0;
        }
        .comic-subtitle { font-size: 12px; color: rgba(255,255,255,.4); margin: 0; }
        .comic-page-display {
            font-family: 'JetBrains Mono', monospace; font-size: 12px;
            color: rgba(255,255,255,.5); white-space: nowrap; flex-shrink: 0;
        }
        .comic-icon-btn {
            background: none; border: none; color: rgba(255,255,255,.6); cursor: pointer;
            padding: 6px; border-radius: 6px; display: flex; align-items: center;
            transition: background 150ms, color 150ms; text-decoration: none;
        }
        .comic-icon-btn:hover { background: rgba(255,255,255,.08); color: #fff; }
        .comic-icon-btn.active { color: var(--amber); }
        .comic-stage {
            flex: 1; min-height: 0; position: relative; display: flex;
            align-items: center; justify-content: center; overflow: hidden;
            cursor: pointer; user-select: none;
        }
        .comic-page-img {
            max-width: 100%; max-height: 100%; object-fit: contain; display: block;
            transition: opacity 100ms, transform 280ms ease;
        }
        .comic-page-img.fading { opacity: 0; }
        .comic-hit-prev, .comic-hit-next {
            position: absolute; top: 0; bottom: 0; width: 40%; z-index: 5;
        }
        .comic-hit-prev { left: 0; } .comic-hit-next { right: 0; }
        .comic-progress { height: 3px; background: rgba(255,255,255,.08); flex-shrink: 0; }
        .comic-progress-fill { height: 100%; background: var(--amber); transition: width 200ms; }

block content
    main.comic-reader
        .comic-topbar
            a.comic-back(href='/comics/read/' + comic.id title='Regular reader')
                svg(xmlns="http://www.w3.org/2000/svg" width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round")
                    polyline(points="15 18 9 12 15 6")
            .comic-title-wrap
                p.comic-title= comic.title
                if comic.series
                    p.comic-subtitle= comic.series + (comic.issue ? ' #' + comic.issue : '')
            span.comic-page-display#page-display
            button.comic-icon-btn#panel-btn(title='Toggle panel mode (P)')
                svg(fill="none" width="18" height="18" viewBox="0 0 24 24" stroke="currentColor" stroke-width="2")
                    rect(x="2" y="3" width="9" height="8" rx="1")
                    rect(x="13" y="3" width="9" height="8" rx="1")
                    rect(x="2" y="13" width="9" height="8" rx="1")
                    rect(x="13" y="13" width="9" height="8" rx="1")
            button.comic-icon-btn#fs-btn(title='Fullscreen')
                svg(xmlns="http://www.w3.org/2000/svg" width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round")
                    polyline#fs-open(points="15 3 21 3 21 9")
                    polyline(points="9 21 3 21 3 15")
                    line(x1="21" y1="3" x2="14" y2="10")
                    line(x1="3" y1="21" x2="10" y2="14")
        .comic-progress
            #progress-fill.comic-progress-fill
        .comic-stage#stage
            .comic-hit-prev#hit-prev
            .comic-hit-next#hit-next
            img.comic-page-img#page-img(alt="")

block scripts
    script.
        const COMIC_ID   = !{JSON.stringify(comic.id)};
        const SAVED_PAGE = !{JSON.stringify(savedPage)};

        const img          = document.getElementById('page-img');
        const stage        = document.getElementById('stage');
        const pageDisplay  = document.getElementById('page-display');
        const progressFill = document.getElementById('progress-fill');
        const panelBtn     = document.getElementById('panel-btn');

        let pages      = [];
        let current    = 0;
        let panelMode  = true;
        let panelIdx   = -1;
        let panelCache = {};

        // ── Panel detection ────────────────────────────────────────────────────

        function detectPanels(imgEl) {
            const W = 220, H = Math.round(220 * imgEl.naturalHeight / imgEl.naturalWidth) || 320;
            const canvas = document.createElement('canvas');
            canvas.width = W; canvas.height = H;
            const ctx = canvas.getContext('2d', { willReadFrequently: true });
            ctx.drawImage(imgEl, 0, 0, W, H);
            const d = ctx.getImageData(0, 0, W, H).data;

            function luma(i) { return d[i]*0.299 + d[i+1]*0.587 + d[i+2]*0.114; }

            const rowB = [], colB = [];
            for (let y = 0; y < H; y++) {
                let s = 0;
                for (let x = 0; x < W; x++) s += luma((y*W+x)*4);
                rowB.push(s / W);
            }
            for (let x = 0; x < W; x++) {
                let s = 0;
                for (let y = 0; y < H; y++) s += luma((y*W+x)*4);
                colB.push(s / H);
            }

            function gaps(arr, sz) {
                const gs = []; let start = -1;
                for (let i = 0; i < sz; i++) {
                    const g = arr[i] > 215 || arr[i] < 30;
                    if (g && start < 0) start = i;
                    else if (!g && start >= 0) {
                        if (i - start >= 3) gs.push([start, i - 1]);
                        start = -1;
                    }
                }
                if (start >= 0 && sz - start >= 3) gs.push([start, sz - 1]);
                return gs;
            }

            function toBands(gs, sz) {
                const bs = []; let cur = 0;
                for (const [s, e] of gs) {
                    if (s - cur >= 6) bs.push([cur, s - 1]);
                    cur = e + 1;
                }
                if (sz - cur >= 6) bs.push([cur, sz - 1]);
                return bs;
            }

            const rBands = toBands(gaps(rowB, H), H);
            const cBands = toBands(gaps(colB, W), W);
            if (rBands.length === 1 && cBands.length === 1) return null;

            const panels = [];
            for (const [y1, y2] of rBands) {
                for (const [x1, x2] of cBands) {
                    panels.push({ x: x1/W, y: y1/H, w: (x2-x1+1)/W, h: (y2-y1+1)/H });
                }
            }
            return panels.length >= 2 ? panels : null;
        }

        // ── Transform ──────────────────────────────────────────────────────────

        function zoomTo(panel) {
            const dW = img.offsetWidth, dH = img.offsetHeight;
            const pCx = (panel.x + panel.w/2) * dW;
            const pCy = (panel.y + panel.h/2) * dH;
            const pW  = panel.w * dW, pH = panel.h * dH;
            const sw  = stage.clientWidth, sh = stage.clientHeight;
            const scale = Math.min(sw/pW*0.9, sh/pH*0.9, 3.5);
            img.style.transformOrigin = 'center';
            img.style.transform = `scale(${scale}) translate(${dW/2 - pCx}px, ${dH/2 - pCy}px)`;
        }

        function resetZoom() {
            img.style.transform = 'none';
        }

        // ── Navigation ────────────────────────────────────────────────────────

        const save = () => fetch('/comics/' + COMIC_ID + '/progress', {
            method: 'POST', headers: { 'Content-Type': 'application/json' },
            body: JSON.stringify({ page: current }),
        });

        async function goTo(n, target) {
            // target: 0+ = specific panel, -1 = last panel, undefined = full page
            n = Math.max(0, Math.min(n, pages.length - 1));
            if (n === current && target === undefined) return;
            current = n;
            panelIdx = -1;
            resetZoom();

            img.classList.add('fading');
            const src = '/comics/page/' + COMIC_ID + '/' + encodeURIComponent(pages[current]);
            const tmp = new Image();
            await new Promise(res => { tmp.onload = res; tmp.onerror = res; tmp.src = src; });

            if (!(current in panelCache)) panelCache[current] = panelMode ? detectPanels(tmp) : null;

            img.src = src;
            img.classList.remove('fading');

            const pct = pages.length > 1 ? (current / (pages.length - 1)) * 100 : 100;
            progressFill.style.width = pct + '%';
            save();

            const panels = panelCache[current];
            if (panelMode && panels) {
                panelIdx = target === -1 ? panels.length - 1 : (target ?? 0);
                panelIdx = Math.max(0, Math.min(panelIdx, panels.length - 1));
                // defer until layout is settled
                setTimeout(() => { zoomTo(panels[panelIdx]); updateHUD(); }, 60);
            } else {
                updateHUD();
            }
        }

        function next() {
            const panels = panelCache[current];
            if (panelMode && panels && panelIdx < panels.length - 1) {
                panelIdx++;
                zoomTo(panels[panelIdx]);
                updateHUD();
            } else {
                goTo(current + 1, 0);
            }
        }

        function prev() {
            const panels = panelCache[current];
            if (panelMode && panels && panelIdx > 0) {
                panelIdx--;
                zoomTo(panels[panelIdx]);
                updateHUD();
            } else {
                goTo(current - 1, -1);
            }
        }

        function togglePanelMode() {
            panelMode = !panelMode;
            if (!panelMode) {
                resetZoom();
                panelIdx = -1;
            } else {
                if (!(current in panelCache)) panelCache[current] = detectPanels(img);
                const panels = panelCache[current];
                if (panels) { panelIdx = 0; setTimeout(() => { zoomTo(panels[0]); updateHUD(); }, 40); }
            }
            updateHUD();
        }

        function updateHUD() {
            const panels = panelCache[current];
            const pInfo = panelMode && panels ? '  ' + (panelIdx + 1) + '/' + panels.length : '';
            pageDisplay.textContent = (current + 1) + ' / ' + pages.length + pInfo;
            panelBtn.classList.toggle('active', panelMode);
        }

        // ── Events ─────────────────────────────────────────────────────────────

        document.getElementById('hit-prev').addEventListener('click', prev);
        document.getElementById('hit-next').addEventListener('click', next);
        panelBtn.addEventListener('click', togglePanelMode);

        document.addEventListener('keydown', e => {
            if (e.key === 'ArrowLeft'  || e.key === 'ArrowUp')   { e.preventDefault(); prev(); }
            if (e.key === 'ArrowRight' || e.key === 'ArrowDown')  { e.preventDefault(); next(); }
            if (e.key === 'p' || e.key === 'P')                   togglePanelMode();
            if (e.key === 'Escape' && document.fullscreenElement) document.exitFullscreen();
        });

        const fsBtn = document.getElementById('fs-btn');
        fsBtn.addEventListener('click', () => {
            if (!document.fullscreenElement) stage.requestFullscreen();
            else document.exitFullscreen();
        });
        document.addEventListener('fullscreenchange', () => {
            const open = document.getElementById('fs-open');
            if (document.fullscreenElement) {
                open.setAttribute('points', '20 14 14 20 20 20');
                document.querySelector('#fs-btn polyline:last-of-type')?.setAttribute('points', '4 10 10 4 4 4');
            } else {
                open.setAttribute('points', '15 3 21 3 21 9');
                document.querySelector('#fs-btn polyline:last-of-type')?.setAttribute('points', '9 21 3 21 3 15');
            }
        });

        // ── Boot ───────────────────────────────────────────────────────────────

        fetch('/comics/pages/' + COMIC_ID)
            .then(r => r.json())
            .then(p => {
                pages = p;
                goTo(Math.min(SAVED_PAGE, pages.length - 1), 0);
            });
